  booToInt3: hx.comps::NumberSwitch? <cdlInstance, cdlName:"booToInt3", cdlOf:@kw.cdl::cdl-ConversionsBooleanToInteger, cdlDefaulted:"integerFalse", cdlFinalBind:"integerTrue", cdlCondition:"have_duaSen"> {
    inFalse: <link:"booToInt3_integerFalse.out">
