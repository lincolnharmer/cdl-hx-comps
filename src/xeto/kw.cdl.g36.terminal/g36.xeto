  proInt1: hx.comps::Multiply? <cdlInstance, cdlName:"proInt1", cdlOf:@kw.cdl::cdl-IntegersMultiply, cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inA: <link:"lowTemAla.out">
