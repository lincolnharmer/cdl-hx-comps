  // Check if the measured airflow is greater than the threshold and the AHU supply fan is OFF
  and5: hx.comps::And? <cdlInstance, cdlName:"and5", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"gre1.out">
    inB: <link:"not3.out">
  }
