  not3: hx.comps::Not? <cdlInstance, cdlName:"not3", cdlOf:@kw.cdl::cdl-LogicalNot> {
    in: <link:"u1Fan">
  }
  // Logical not
  not4: hx.comps::Not? <cdlInstance, cdlName:"not4", cdlOf:@kw.cdl::cdl-LogicalNot> {
