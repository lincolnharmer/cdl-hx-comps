  lowFloAla: hx.comps::NumberSwitch? <cdlInstance, cdlName:"lowFloAla", cdlOf:@kw.cdl::cdl-IntegersSwitch> {
    inTrue: <link:"conInt.out">
    inSwitch: <link:"and13.out">
    inFalse: <link:"booToInt.out">
  }
  // Low discharge temperature alarm
  lowTemAla: hx.comps::NumberSwitch? <cdlInstance, cdlName:"lowTemAla", cdlOf:@kw.cdl::cdl-IntegersSwitch, cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
