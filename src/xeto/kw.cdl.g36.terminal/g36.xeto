  fanIni: hx.comps::BoolDelay? <cdlInstance, cdlName:"fanIni", cdlOf:@kw.cdl::cdl-LogicalTrueDelay, cdlBind:{delayTime:"staTim"}, cdlFinalBind:"delayTime"> {
    offDelay: 0sec
    in: <link:"u1Fan">
  }
  // Percentage of the setpoint
  gai: hx.comps::Multiply? <cdlInstance, cdlName:"gai", cdlOf:@kw.cdl::cdl-RealsMultiplyByParameter, cdlFinalBind:"k"> {
    inB: <link:"gai_k.out">
    inA: <link:"vActSet_flow">
  }
  // Percentage of the setpoint
  gai1: hx.comps::Multiply? <cdlInstance, cdlName:"gai1", cdlOf:@kw.cdl::cdl-RealsMultiplyByParameter, cdlFinalBind:"k"> {
    inB: <link:"gai1_k.out">
    inA: <link:"vActSet_flow">
  }
  // Percentage of the setpoint
  gai2: hx.comps::Multiply? <cdlInstance, cdlName:"gai2", cdlOf:@kw.cdl::cdl-RealsMultiplyByParameter, cdlFinalBind:"k"> {
    inB: <link:"gai2_k.out">
    inA: <link:"cooMaxFlo.out">
  }
  // Check if measured airflow is less than threshold
  gre: hx.comps::GreaterThanHys? <cdlInstance, cdlName:"gre", cdlOf:@kw.cdl::cdl-RealsGreater, cdlBind:{h:"floHys"}, cdlFinalBind:"h"> {
