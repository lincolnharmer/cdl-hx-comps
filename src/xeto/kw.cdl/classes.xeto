  comp: hx.comps::WetBulb
  connectors: {phi:"inRelHumidity", tDryBul:"inDryBulb", tWetBul:"out"}
  departures: {"It uses the Stull (2011) approximation, valid for 5 % to 99 % and -20 °C to 50 °C within -1 K to +0.65 K.", "`out` is in the unit of `inDryBulb`.", "`inDryBulb` is in kelvin when unitless, and K, °C and °F convert. `inRelHumidity` is a fraction when unitless, and % converts.", "An out of range or non-finite input gives NaN with no fault.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"A", keep:"TDryBul,TWetBul"}
  cdlNames: {tDryBul:"TDryBul", tWetBul:"TWetBul"}
  bounds: {phi:{cdlMin:"0", cdlMax:"1"}, tDryBul:{cdlMin:"100"}, tWetBul:{cdlMin:"100"}}
  state: "stateless"
}

