  not6: hx.comps::Not? <cdlInstance, cdlName:"not6", cdlOf:@kw.cdl::cdl-LogicalNot, cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    in: <link:"and15.out">
  }
  // Logical not
  not7: hx.comps::Not? <cdlInstance, cdlName:"not7", cdlOf:@kw.cdl::cdl-LogicalNot, cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    in: <link:"and14.out">
  }
  // Logical not
  not8: hx.comps::Not? <cdlInstance, cdlName:"not8", cdlOf:@kw.cdl::cdl-LogicalNot> {
    in: <link:"truDel6.out">
  }
