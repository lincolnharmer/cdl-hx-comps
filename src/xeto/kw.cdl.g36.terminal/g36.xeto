  assMes5: hx.comps::Assert? <cdlInstance, cdlName:"assMes5", cdlOf:@kw.cdl::cdl-UtilitiesAssert, cdlFinalBind:"message", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
