  }
  // Check if valve position is near zero
  cloVal: hx.comps::LessThanHys? <cdlInstance, cdlName:"cloVal", cdlOf:@kw.cdl::cdl-RealsLessThreshold, cdlBind:{h:"0.5*valPosHys", t:"valPosHys"}, cdlFinalBind:"h,t"> {
    inB: <link:"cloVal_t.out">
    inA: <link:"uVal">
  }
  // Level 2 alarm
  conInt: hx.comps::NumberConst? <cdlInstance, cdlName:"conInt", cdlOf:@kw.cdl::cdl-IntegersSourcesConstant, cdlFinalBind:"k"> {
    out: hx.comps::StatusNumber { val: 2 }
  }
  // Importance multiplier for zone static pressure reset
  conInt1: hx.comps::NumberConst? <cdlInstance, cdlName:"conInt1", cdlOf:@kw.cdl::cdl-RealsSourcesConstant, cdlBind:{k:"staPreMul"}, cdlFinalBind:"k">
  // Level 2 alarm
  conInt2: hx.comps::NumberConst? <cdlInstance, cdlName:"conInt2", cdlOf:@kw.cdl::cdl-IntegersSourcesConstant, cdlFinalBind:"k", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    out: hx.comps::StatusNumber { val: 2 }
  }
  // Importance multiplier for hot water reset control
  conInt3: hx.comps::NumberConst? <cdlInstance, cdlName:"conInt3", cdlOf:@kw.cdl::cdl-RealsSourcesConstant, cdlBind:{k:"hotWatRes"}, cdlFinalBind:"k", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased">
  // Level 2 alarm
  conInt4: hx.comps::NumberConst? <cdlInstance, cdlName:"conInt4", cdlOf:@kw.cdl::cdl-IntegersSourcesConstant, cdlFinalBind:"k"> {
    out: hx.comps::StatusNumber { val: 2 }
  }
  // Cooling maximum airflow setpoint
  cooMaxFlo: hx.comps::NumberConst? <cdlInstance, cdlName:"cooMaxFlo", cdlOf:@kw.cdl::cdl-RealsSourcesConstant, cdlBind:{k:"VCooMax_flow"}, cdlFinalBind:"k">
  // Check if the AHU supply fan has been enabled for threshold time
  fanIni: hx.comps::BoolDelay? <cdlInstance, cdlName:"fanIni", cdlOf:@kw.cdl::cdl-LogicalTrueDelay, cdlBind:{delayTime:"staTim"}, cdlFinalBind:"delayTime"> {
    offDelay: 0sec
    in: <link:"u1Fan">
  }
  // Fan status alarm
  fanStaAla: hx.comps::NumberSwitch? <cdlInstance, cdlName:"fanStaAla", cdlOf:@kw.cdl::cdl-IntegersSwitch> {
    inTrue: <link:"conInt4.out">
    inSwitch: <link:"and16.out">
    inFalse: <link:"booToInt7.out">
  }
  // Percentage of the setpoint
  gai: hx.comps::Multiply? <cdlInstance, cdlName:"gai", cdlOf:@kw.cdl::cdl-RealsMultiplyByParameter, cdlFinalBind:"k"> {
    inB: <link:"gai_k.out">
    inA: <link:"vActSet_flow">
  }
  // Percentage of the setpoint
  gai1: hx.comps::Multiply? <cdlInstance, cdlName:"gai1", cdlOf:@kw.cdl::cdl-RealsMultiplyByParameter, cdlFinalBind:"k"> {
    inB: <link:"gai1_k.out">
    inA: <link:"vActSet_flow">
  }
  // Percentage of the setpoint
  gai2: hx.comps::Multiply? <cdlInstance, cdlName:"gai2", cdlOf:@kw.cdl::cdl-RealsMultiplyByParameter, cdlFinalBind:"k"> {
    inB: <link:"gai2_k.out">
    inA: <link:"cooMaxFlo.out">
  }
  // Check if measured airflow is less than threshold
  gre: hx.comps::GreaterThanHys? <cdlInstance, cdlName:"gre", cdlOf:@kw.cdl::cdl-RealsGreater, cdlBind:{h:"floHys"}, cdlFinalBind:"h"> {
    inA: <link:"gai1.out">
    inB: <link:"vPri_flow">
  }
  // Check if measured airflow is greater than threshold
  gre1: hx.comps::GreaterThanHys? <cdlInstance, cdlName:"gre1", cdlOf:@kw.cdl::cdl-RealsGreater, cdlBind:{h:"floHys"}, cdlFinalBind:"h"> {
    inA: <link:"vPri_flow">
    inB: <link:"gai2.out">
  }
  // Discharge temperature greate than AHU supply temperature by a threshold
  gre2: hx.comps::GreaterThanHys? <cdlInstance, cdlName:"gre2", cdlOf:@kw.cdl::cdl-RealsGreater, cdlBind:{h:"dTHys"}, cdlFinalBind:"h"> {
    inA: <link:"tDis">
    inB: <link:"addPar2.out">
  }
  // Check if setpoint airflow is greater than zero
  greThr: hx.comps::GreaterThanHys? <cdlInstance, cdlName:"greThr", cdlOf:@kw.cdl::cdl-RealsGreaterThreshold, cdlBind:{h:"0.5*floHys", t:"floHys"}, cdlFinalBind:"h,t"> {
    inB: <link:"greThr_t.out">
    inA: <link:"vActSet_flow">
  }
  // Check if the multiplier is greater than zero
  greThr1: hx.comps::GreaterThanHys? <cdlInstance, cdlName:"greThr1", cdlOf:@kw.cdl::cdl-RealsGreaterThreshold, cdlDefaulted:"t"> {
    inB: <link:"greThr1_t.out">
    inA: <link:"conInt1.out">
  }
  // Check if the multiplier is greater than zero
  greThr2: hx.comps::GreaterThanHys? <cdlInstance, cdlName:"greThr2", cdlOf:@kw.cdl::cdl-RealsGreaterThreshold, cdlDefaulted:"t", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inB: <link:"greThr2_t.out">
    inA: <link:"conInt3.out">
  }
  // Check if current operation mode is occupied mode
  isOcc: hx.comps::Equal? <cdlInstance, cdlName:"isOcc", cdlOf:@kw.cdl::cdl-IntegersEqual> {
    inA: <link:"uOpeMod">
    inB: <link:"occMod.out">
  }
  // Check if generating leak damper alarms
  leaDamAla: hx.comps::And? <cdlInstance, cdlName:"leaDamAla", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"gre1.out">
    inB: <link:"u1Fan">
  }
  // Check if generating leak damper alarms
  leaDamAla1: hx.comps::And? <cdlInstance, cdlName:"leaDamAla1", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"leaDamAla.out">
    inB: <link:"cloDam.out">
  }
