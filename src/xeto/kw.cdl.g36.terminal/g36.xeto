    inB: <link:"vDis_flow">
  }
  // Check if measured airflow is greater than threshold
  gre1: hx.comps::GreaterThanHys? <cdlInstance, cdlName:"gre1", cdlOf:@kw.cdl::cdl-RealsGreater, cdlBind:{h:"floHys"}, cdlFinalBind:"h"> {
    inA: <link:"vDis_flow">
    inB: <link:"gai2.out">
  }
  // Discharge temperature greate than AHU supply temperature by a threshold
