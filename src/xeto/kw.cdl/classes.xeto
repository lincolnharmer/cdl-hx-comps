  comp: hx.comps::Limiter
  connectors: {u:"in", y:"out"}
  params: {uMax:"uMax", uMin:"uMin"}
  departures: {"Equal limits give that value. MBL rejects them.", "Limits convert to the unit of `in`, an offset included, so a °C limit fits a °F `in`.", "`uMax` and `uMin` have no default and `out` is NaN with fault until both are set.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"A", keep:"u,uMin,uMax,y"}
  state: "stateless"
}

