  tdHeaCoi: Number? <cdlParam, cdlName:"TdHeaCoi", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", cdlMinWhen:List {CdlBoundWhen {val:Number "1e-13", cond:"have_heaCoi", via:"conPIDHea.td"}}, cdlEnable:"(heaCoiConTyp == Buildings.Controls.OBC.CDL.Types.SimpleController.PD or heaCoiConTyp == Buildings.Controls.OBC.CDL.Types.SimpleController.PID) and have_heaCoi", cdlGroup:"Heating coil", cdlTab:"PID controller parameters"> "0.1"
  // Integrator time constant
  tiCooCoi: Number? <cdlParam, cdlName:"TiCooCoi", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", cdlMinWhen:List {CdlBoundWhen {val:Number "1e-13", cond:"have_cooCoi", via:"conPIDCoo.ti"}}, cdlEnable:"(cooCoiConTyp == Buildings.Controls.OBC.CDL.Types.SimpleController.PI or cooCoiConTyp == Buildings.Controls.OBC.CDL.Types.SimpleController.PID) and have_cooCoi", cdlGroup:"Cooling coil", cdlTab:"PID controller parameters"> "60"
  // Integrator block time constant
  tiHeaCoi: Number? <cdlParam, cdlName:"TiHeaCoi", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", cdlMinWhen:List {CdlBoundWhen {val:Number "1e-13", cond:"have_heaCoi", via:"conPIDHea.ti"}}, cdlEnable:"(heaCoiConTyp == Buildings.Controls.OBC.CDL.Types.SimpleController.PI or heaCoiConTyp == Buildings.Controls.OBC.CDL.Types.SimpleController.PID) and have_heaCoi", cdlGroup:"Heating coil", cdlTab:"PID controller parameters"> "60"
  // Supply air temperature setpoint at maximum heating loop signal
  tSupSet_max: Number? <cdlParam, cdlName:"TSupSet_max", cdlType:"Real", cdlUnit:"K", quantity:"temperature", cdlQuantityInferred, cdlEnable:"have_heaCoi", cdlGroup:"Heating loop", cdlValueInReference:"false"> "305.15"
  // Supply air temperature setpoint at maximum cooling loop signal
  tSupSet_min: Number? <cdlParam, cdlName:"TSupSet_min", cdlType:"Real", cdlUnit:"K", quantity:"temperature", cdlQuantityInferred, cdlEnable:"have_cooCoi", cdlGroup:"Cooling loop", cdlValueInReference:"false"> "285.95"
  // Maximum cooling loop signal at which supply air temperature is modified
  uCoo_max: Number? <cdlParam, cdlName:"uCoo_max", cdlType:"Real", cdlUnit:"1", unitless, cdlEnable:"have_cooCoi", cdlGroup:"Cooling loop"> "0.5"
  // Minimum cooling loop signal at which supply air temperature is modified
  uCoo_min: Number? <cdlParam, cdlName:"uCoo_min", cdlType:"Real", cdlUnit:"1", unitless, cdlEnable:"have_cooCoi", cdlGroup:"Cooling loop", cdlDefault:"cooDea">
  // Maximum heating loop signal at which supply air temperature is modified
  uHea_max: Number? <cdlParam, cdlName:"uHea_max", cdlType:"Real", cdlUnit:"1", unitless, cdlEnable:"have_heaCoi", cdlGroup:"Heating loop"> "0.5"
  // Minimum heating loop signal at which supply air temperature is modified
  uHea_min: Number? <cdlParam, cdlName:"uHea_min", cdlType:"Real", cdlUnit:"1", unitless, cdlEnable:"have_heaCoi", cdlGroup:"Heating loop", cdlDefault:"heaDea">
  // Measured supply air temperature
  tAirSup: hx.comps::StatusNumber? <cdlInput, cdlName:"TAirSup", cdlType:"Real", cdlUnit:"K", cdlQuantityKind:"ThermodynamicTemperature", quantity:"temperature", cdlPointSpec:ph.points.x::DischargeAirTempSensor, cdlPointScope:"self">
  // Zone cooling temperature setpoint
  tZonCooSet: hx.comps::StatusNumber? <cdlInput, cdlName:"TZonCooSet", cdlType:"Real", cdlUnit:"K", cdlQuantityKind:"ThermodynamicTemperature", quantity:"temperature", cdlCondition:"have_cooCoi">
  // Zone heating temperature setpoint
  tZonHeaSet: hx.comps::StatusNumber? <cdlInput, cdlName:"TZonHeaSet", cdlType:"Real", cdlUnit:"K", cdlQuantityKind:"ThermodynamicTemperature", quantity:"temperature", cdlCondition:"have_heaCoi">
  // Fan proven on signal
  u1Fan: hx.comps::StatusBool? <cdlInput, cdlName:"u1Fan", cdlType:"Boolean", cdlPointSpec:ph.points.x::DischargeFanRunSensor, cdlPointScope:"self">
  // Cooling loop signal
  uCoo: hx.comps::StatusNumber? <cdlInput, cdlName:"uCoo", cdlType:"Real", cdlUnit:"1", unitless, cdlCondition:"have_cooCoi">
  // Heating loop signal
  uHea: hx.comps::StatusNumber? <cdlInput, cdlName:"uHea", cdlType:"Real", cdlUnit:"1", unitless, cdlCondition:"have_heaCoi">
  // Supply air temperature setpoint
  tSupSet: hx.comps::StatusNumber? <cdlOutput, cdlName:"TSupSet", cdlType:"Real", cdlUnit:"K", cdlQuantityKind:"ThermodynamicTemperature", quantity:"temperature", transient, readonly, cdlPointSpec:ph.points.x::DischargeAirTempSp, cdlPointScope:"self", link:"swiDeaCoo.out">
  // Cooling coil signal
  yCooCoi: hx.comps::StatusNumber? <cdlOutput, cdlName:"yCooCoi", cdlType:"Real", cdlUnit:"1", unitless, cdlCondition:"have_cooCoi", transient, readonly, link:"mul3.out">
  // Heating coil signal
  yHeaCoi: hx.comps::StatusNumber? <cdlOutput, cdlName:"yHeaCoi", cdlType:"Real", cdlUnit:"1", unitless, cdlCondition:"have_heaCoi", transient, readonly, link:"mul2.out">
  // Boolean to Real conversion
  booToRea2: hx.comps::NumberSwitch? <cdlInstance, cdlName:"booToRea2", cdlOf:@kw.cdl::cdl-ConversionsBooleanToReal, cdlDefaulted:"realFalse,realTrue"> {
    inFalse: <link:"booToRea2_realFalse.out">
    inTrue: <link:"booToRea2_realTrue.out">
    inSwitch: <link:"u1Fan">
  }
  // Constant false
  con: hx.comps::BoolConst? <cdlInstance, cdlName:"con", cdlOf:@kw.cdl::cdl-LogicalSourcesConstant, cdlFinalBind:"k", cdlCondition:"not have_cooCoi"> {
    out: hx.comps::StatusBool { val: "false" }
  }
  // PID controller for cooling coil
  conPIDCoo: hx.comps::CdlPid? <cdlInstance, cdlName:"conPIDCoo", cdlOf:@kw.cdl::cdl-RealsPid, cdlBind:{controllerType:"cooCoiConTyp", k:"kCooCoi", td:"TdCooCoi", ti:"TiCooCoi"}, cdlLiteralUnits:{r:"K"}, cdlLiteralDelta:"r", cdlFinalBind:"controllerType,k,reverseActing,td,ti", cdlCondition:"have_cooCoi"> {
    r: 10
    reverseActing: "false"
    inMeasurement: <link:"tAirSup">
    inSetpoint: <link:"swiDeaCoo.out">
  }
  // PID controller for heating coil
  conPIDHea: hx.comps::CdlPid? <cdlInstance, cdlName:"conPIDHea", cdlOf:@kw.cdl::cdl-RealsPid, cdlBind:{controllerType:"heaCoiConTyp", k:"kHeaCoi", td:"TdHeaCoi", ti:"TiHeaCoi"}, cdlLiteralUnits:{r:"K"}, cdlLiteralDelta:"r", cdlFinalBind:"controllerType,k,td,ti", cdlCondition:"have_heaCoi"> {
    r: 10
    inMeasurement: <link:"tAirSup">
    inSetpoint: <link:"swiDeaCoo.out">
  }
  // Maximum heating supply air temperature setpoint limit signal
  conTSupSet_max: hx.comps::NumberConst? <cdlInstance, cdlName:"conTSupSet_max", cdlOf:@kw.cdl::cdl-RealsSourcesConstant, cdlBind:{k:"TSupSet_max"}, cdlFinalBind:"k", cdlCondition:"have_heaCoi">
  // Minimum cooling supply air temperature setpoint limit signal
  conTSupSet_min: hx.comps::NumberConst? <cdlInstance, cdlName:"conTSupSet_min", cdlOf:@kw.cdl::cdl-RealsSourcesConstant, cdlBind:{k:"TSupSet_min"}, cdlFinalBind:"k", cdlCondition:"have_cooCoi">
  // Maximum cooling loop signal support point
  conUCoo_max: hx.comps::NumberConst? <cdlInstance, cdlName:"conUCoo_max", cdlOf:@kw.cdl::cdl-RealsSourcesConstant, cdlBind:{k:"uCoo_max"}, cdlFinalBind:"k", cdlCondition:"have_cooCoi">
  // Minimum cooling loop signal support point
  conUCoo_min: hx.comps::NumberConst? <cdlInstance, cdlName:"conUCoo_min", cdlOf:@kw.cdl::cdl-RealsSourcesConstant, cdlBind:{k:"uCoo_min"}, cdlFinalBind:"k", cdlCondition:"have_cooCoi">
  // Maximum heating loop signal support point
  conUHea_max: hx.comps::NumberConst? <cdlInstance, cdlName:"conUHea_max", cdlOf:@kw.cdl::cdl-RealsSourcesConstant, cdlBind:{k:"uHea_max"}, cdlFinalBind:"k", cdlCondition:"have_heaCoi">
  // Minimum heating loop signal support point
  conUHea_min: hx.comps::NumberConst? <cdlInstance, cdlName:"conUHea_min", cdlOf:@kw.cdl::cdl-RealsSourcesConstant, cdlBind:{k:"uHea_min"}, cdlFinalBind:"k", cdlCondition:"have_heaCoi">
  // Constant zero signal
  conZer: hx.comps::NumberConst? <cdlInstance, cdlName:"conZer", cdlOf:@kw.cdl::cdl-RealsSourcesConstant, cdlLiteralUnits:{out:"1"}, cdlFinalBind:"k"> {
    out: hx.comps::StatusNumber { val: 0 }
  }
  // Dummy gain
  gai: hx.comps::Multiply? <cdlInstance, cdlName:"gai", cdlOf:@kw.cdl::cdl-RealsMultiplyByParameter, cdlFinalBind:"k", cdlCondition:"not have_heaCoi"> {
    inB: <link:"gai_k.out">
    inA: <link:"tAirSup">
  }
  // Dummy gain
  gai1: hx.comps::Multiply? <cdlInstance, cdlName:"gai1", cdlOf:@kw.cdl::cdl-RealsMultiplyByParameter, cdlFinalBind:"k", cdlCondition:"not have_cooCoi"> {
    inB: <link:"gai1_k.out">
    inA: <link:"tAirSup">
  }
  // Hysteresis for switching on cooling mode from deadband mode
  hysDeaCoo: hx.comps::Hysteresis? <cdlInstance, cdlName:"hysDeaCoo", cdlOf:@kw.cdl::cdl-RealsHysteresis, cdlBind:{uHigh:"cooDea", uLow:"cooDea -deaHysLim"}, cdlFinalBind:"uHigh,uLow", cdlCondition:"have_cooCoi"> {
    in: <link:"uCoo">
  }
  // Hysteresis for switching between deadband mode and heating mode
  hysDeaHea: hx.comps::Hysteresis? <cdlInstance, cdlName:"hysDeaHea", cdlOf:@kw.cdl::cdl-RealsHysteresis, cdlBind:{uHigh:"heaDea", uLow:"heaDea -deaHysLim"}, cdlFinalBind:"uHigh,uLow", cdlCondition:"have_heaCoi"> {
    in: <link:"uHea">
  }
  // Convert cooling loop signal to supply air temperature setpoint
  linTCooSupAir: hx.comps::Line? <cdlInstance, cdlName:"linTCooSupAir", cdlOf:@kw.cdl::cdl-RealsLine, cdlCondition:"have_cooCoi"> {
    inF1: <link:"tZonCooSet">
    inF2: <link:"conTSupSet_min.out">
    in: <link:"uCoo">
    inX1: <link:"conUCoo_min.out">
    inX2: <link:"conUCoo_max.out">
  }
  // Convert heating loop signal to supply air temperature setpoint
  linTHeaSupAir: hx.comps::Line? <cdlInstance, cdlName:"linTHeaSupAir", cdlOf:@kw.cdl::cdl-RealsLine, cdlCondition:"have_heaCoi"> {
    inF1: <link:"tZonHeaSet">
    inF2: <link:"conTSupSet_max.out">
    in: <link:"uHea">
    inX1: <link:"conUHea_min.out">
    inX2: <link:"conUHea_max.out">
  }
  // Output heating coil signal only when fan is proven on
  mul2: hx.comps::Multiply? <cdlInstance, cdlName:"mul2", cdlOf:@kw.cdl::cdl-RealsMultiply, cdlCondition:"have_heaCoi"> {
    inA: <link:"booToRea2.out">
    inB: <link:"swiHeaCoi.out">
  }
  // Output cooling coil signal only when fan is proven on
  mul3: hx.comps::Multiply? <cdlInstance, cdlName:"mul3", cdlOf:@kw.cdl::cdl-RealsMultiply, cdlCondition:"have_cooCoi"> {
    inA: <link:"booToRea2.out">
    inB: <link:"swiCooCoi.out">
  }
  // Switch cooling coil signal to zero in deadband mode
  swiCooCoi: hx.comps::NumberSwitch? <cdlInstance, cdlName:"swiCooCoi", cdlOf:@kw.cdl::cdl-RealsSwitch, cdlCondition:"have_cooCoi"> {
    inTrue: <link:"conPIDCoo.out">
    inSwitch: <link:"hysDeaCoo.out">
    inFalse: <link:"conZer.out">
  }
  // Switch for turning on cooling mode from deadband mode
  swiDeaCoo: hx.comps::NumberSwitch? <cdlInstance, cdlName:"swiDeaCoo", cdlOf:@kw.cdl::cdl-RealsSwitch> {
    inTrue: <cdlAltLink:"gai1.out,linTCooSupAir.out">
    inSwitch: <cdlAltLink:"con.out,hysDeaCoo.out">
    inFalse: <cdlAltLink:"gai.out,swiDeaHea.out">
  }
  // Switch for turning on heating mode from deadband mode
  swiDeaHea: hx.comps::NumberSwitch? <cdlInstance, cdlName:"swiDeaHea", cdlOf:@kw.cdl::cdl-RealsSwitch, cdlCondition:"have_heaCoi"> {
    inTrue: <link:"linTHeaSupAir.out">
    inSwitch: <link:"hysDeaHea.out">
    inFalse: <link:"tAirSup">
  }
  // Switch heating coil signal to zero in deadband mode
  swiHeaCoi: hx.comps::NumberSwitch? <cdlInstance, cdlName:"swiHeaCoi", cdlOf:@kw.cdl::cdl-RealsSwitch, cdlCondition:"have_heaCoi"> {
    inTrue: <link:"conPIDHea.out">
    inSwitch: <link:"hysDeaHea.out">
    inFalse: <link:"conZer.out">
  }
  booToRea2_realFalse: hx.comps::NumberConst? <cdlFeed:"booToRea2.realFalse", cdlLiteralUnits:{out:"1"}> {
    out: hx.comps::StatusNumber { val: 0 }
  }
  booToRea2_realTrue: hx.comps::NumberConst? <cdlFeed:"booToRea2.realTrue", cdlLiteralUnits:{out:"1"}> {
    out: hx.comps::StatusNumber { val: 1 }
  }
  gai_k: hx.comps::NumberConst? <cdlFeed:"gai.k", cdlLiteralUnits:{out:"1"}, cdlCondition:"not have_heaCoi"> {
    out: hx.comps::StatusNumber { val: 1 }
  }
  gai1_k: hx.comps::NumberConst? <cdlFeed:"gai1.k", cdlLiteralUnits:{out:"1"}, cdlCondition:"not have_cooCoi"> {
    out: hx.comps::StatusNumber { val: 1 }
  }
}
