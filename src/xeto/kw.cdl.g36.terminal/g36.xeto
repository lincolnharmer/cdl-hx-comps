  }
  // Check if setpoint airflow is greater than zero
  greThr: hx.comps::GreaterThanHys? <cdlInstance, cdlName:"greThr", cdlOf:@kw.cdl::cdl-RealsGreaterThreshold, cdlBind:{h:"0.5*floHys", t:"floHys"}, cdlFinalBind:"h"> {
    inB: <link:"greThr_t.out">
    inA: <link:"vActSet_flow">
  }
  // Check if the multiplier is greater than zero
  greThr1: hx.comps::GreaterThanHys? <cdlInstance, cdlName:"greThr1", cdlOf:@kw.cdl::cdl-RealsGreaterThreshold, cdlDefaulted:"t"> {
    inB: <link:"greThr1_t.out">
    inA: <link:"conInt1.out">
  }
  // Check if the multiplier is greater than zero
  greThr2: hx.comps::GreaterThanHys? <cdlInstance, cdlName:"greThr2", cdlOf:@kw.cdl::cdl-RealsGreaterThreshold, cdlDefaulted:"t", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inB: <link:"greThr2_t.out">
    inA: <link:"conInt3.out">
  }
  // Check if current operation mode is occupied mode
  isOcc: hx.comps::Equal? <cdlInstance, cdlName:"isOcc", cdlOf:@kw.cdl::cdl-IntegersEqual> {
    inA: <link:"uOpeMod">
    inB: <link:"occMod.out">
  }
  // Check if generating leak damper alarms
  leaDamAla: hx.comps::And? <cdlInstance, cdlName:"leaDamAla", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"gre1.out">
    inB: <link:"u1Fan">
  }
  // Check if generating leak damper alarms
  leaDamAla1: hx.comps::And? <cdlInstance, cdlName:"leaDamAla1", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"leaDamAla.out">
    inB: <link:"cloDam.out">
  }
