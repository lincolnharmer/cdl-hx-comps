    inSwitch: <link:"and15.out">
    inFalse: <link:"booToInt4.out">
  }
  // Logical not
  not1: hx.comps::Not? <cdlInstance, cdlName:"not1", cdlOf:@kw.cdl::cdl-LogicalNot> {
