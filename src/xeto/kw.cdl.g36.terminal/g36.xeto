  vHeaMin_flow: Number <cdlParam, cdlName:"VHeaMin_flow", cdlType:"Real", cdlUnit:"m³/s", quantity:"volumetricFlow", cdlGroup:"Design conditions">
  // Design zone minimum airflow setpoint
