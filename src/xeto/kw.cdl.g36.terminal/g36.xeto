  vCooMax_flow: Number <cdlParam, cdlName:"VCooMax_flow", cdlType:"Real", cdlUnit:"m³/s", cdlQuantityKind:"VolumeFlowRate", quantity:"volumetricFlow">
  // Measured discharge air temperature
  tDis: hx.comps::StatusNumber? <cdlInput, cdlName:"TDis", cdlType:"Real", cdlUnit:"K", cdlQuantityKind:"ThermodynamicTemperature", quantity:"temperature", cdlPointSpec:ph.points.x::DischargeAirTempSensor, cdlPointScope:"self">
  // Discharge air temperature setpoint
  tDisSet: hx.comps::StatusNumber? <cdlInput, cdlName:"TDisSet", cdlType:"Real", cdlUnit:"K", cdlQuantityKind:"ThermodynamicTemperature", quantity:"temperature", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased">
  // Temperature of the air supplied from central air handler
  tSup: hx.comps::StatusNumber? <cdlInput, cdlName:"TSup", cdlType:"Real", cdlUnit:"K", cdlQuantityKind:"ThermodynamicTemperature", quantity:"temperature", cdlPointSpec:ph.points.x::DischargeAirTempSensor, cdlPointScope:"upstreamAir">
  // Terminal fan status
  u1Fan: hx.comps::StatusBool? <cdlInput, cdlName:"u1Fan", cdlType:"Boolean", cdlPointSpec:ph.points.x::DischargeFanRunSensor, cdlPointScope:"upstreamAir">
  // Terminal fan command on
  u1FanCom: hx.comps::StatusBool? <cdlInput, cdlName:"u1FanCom", cdlType:"Boolean">
  // Hot water plant status
  u1HotPla: hx.comps::StatusBool? <cdlInput, cdlName:"u1HotPla", cdlType:"Boolean", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased">
  // Terminal fan status
  u1TerFan: hx.comps::StatusBool? <cdlInput, cdlName:"u1TerFan", cdlType:"Boolean", cdlPointSpec:ph.points.x::DischargeFanRunSensor, cdlPointScope:"self">
  // Damper position setpoint
  uDam: hx.comps::StatusNumber? <cdlInput, cdlName:"uDam", cdlType:"Real", cdlUnit:"1", unitless, cdlMin:"0">
  // Zone operation mode
  uOpeMod: hx.comps::StatusNumber? <cdlInput, cdlName:"uOpeMod", cdlType:"Integer">
  // Actual valve position
  uVal: hx.comps::StatusNumber? <cdlInput, cdlName:"uVal", cdlType:"Real", cdlUnit:"1", unitless, cdlMin:"0">
  // Active airflow setpoint
  vActSet_flow: hx.comps::StatusNumber? <cdlInput, cdlName:"VActSet_flow", cdlType:"Real", cdlUnit:"m³/s", cdlQuantityKind:"VolumeFlowRate", quantity:"volumetricFlow", cdlMin:"0">
  // Measured primary airflow rate
  vPri_flow: hx.comps::StatusNumber? <cdlInput, cdlName:"VPri_flow", cdlType:"Real", cdlUnit:"m³/s", cdlQuantityKind:"VolumeFlowRate", quantity:"volumetricFlow", cdlMin:"0", cdlPointSpec:ph.points.x::InletAirFlowSensor, cdlPointScope:"self">
  // Fan status alarm
  yFanStaAla: hx.comps::StatusNumber? <cdlOutput, cdlName:"yFanStaAla", cdlType:"Integer", transient, readonly, link:"fanStaAla.out">
  // Airflow sensor calibration alarm
  yFloSenAla: hx.comps::StatusNumber? <cdlOutput, cdlName:"yFloSenAla", cdlType:"Integer", transient, readonly, link:"booToInt2.out">
  // Leaking damper alarm
  yLeaDamAla: hx.comps::StatusNumber? <cdlOutput, cdlName:"yLeaDamAla", cdlType:"Integer", transient, readonly, link:"booToInt3.out">
  // Leaking valve alarm
  yLeaValAla: hx.comps::StatusNumber? <cdlOutput, cdlName:"yLeaValAla", cdlType:"Integer", transient, readonly, link:"booToInt6.out">
  // Low airflow alarms
  yLowFloAla: hx.comps::StatusNumber? <cdlOutput, cdlName:"yLowFloAla", cdlType:"Integer", transient, readonly, link:"proInt.out">
  // Low discharge air temperature alarms
  yLowTemAla: hx.comps::StatusNumber? <cdlOutput, cdlName:"yLowTemAla", cdlType:"Integer", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased", transient, readonly, link:"proInt1.out">
  // Setpoint temperature minus a threshold
  addPar: hx.comps::Add? <cdlInstance, cdlName:"addPar", cdlOf:@kw.cdl::cdl-RealsAddParameter, cdlFinalBind:"p", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inB: <link:"addPar_p.out">
    inA: <link:"tDisSet">
  }
  // Setpoint temperature minus a threshold
  addPar1: hx.comps::Add? <cdlInstance, cdlName:"addPar1", cdlOf:@kw.cdl::cdl-RealsAddParameter, cdlFinalBind:"p", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inB: <link:"addPar1_p.out">
    inA: <link:"tDisSet">
  }
  // AHU supply temperature plus 3 degree
  addPar2: hx.comps::Add? <cdlInstance, cdlName:"addPar2", cdlOf:@kw.cdl::cdl-RealsAddParameter, cdlFinalBind:"p"> {
    inB: <link:"addPar2_p.out">
    inA: <link:"tSup">
  }
  // Measured airflow has been less than threshold value for sufficient time
  and1: hx.comps::And? <cdlInstance, cdlName:"and1", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"truDel9.out">
    inB: <link:"truDel1.out">
  }
  // Check if the fan has been commond off for threshold time and fan is still on
  and10: hx.comps::And? <cdlInstance, cdlName:"and10", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"u1TerFan">
    inB: <link:"not9.out">
  }
  // Check if the fan has been commond on for threshold time and fan is still off
  and11: hx.comps::And? <cdlInstance, cdlName:"and11", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"not12.out">
    inB: <link:"u1FanCom">
  }
  // True: AHU fan is enabled and the discharge flow is lower than the threshold
  and12: hx.comps::And? <cdlInstance, cdlName:"and12", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"gre.out">
    inB: <link:"fanIni.out">
  }
  // True: AHU fan is enabled and the discharge flow is lower than the threshold
  and13: hx.comps::And? <cdlInstance, cdlName:"and13", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"les.out">
    inB: <link:"fanIni.out">
  }
  // Logical and
  and14: hx.comps::And? <cdlInstance, cdlName:"and14", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"and1.out">
    inB: <link:"greThr1.out">
  }
  // Logical and
  and15: hx.comps::And? <cdlInstance, cdlName:"and15", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"and4.out">
    inB: <link:"isOcc.out">
  }
  // Check if the fan has been commond on for threshold time and fan is still off
  and16: hx.comps::And? <cdlInstance, cdlName:"and16", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"and11.out">
    inB: <link:"truDel7.out">
  }
  // Check if the fan has been commond off for threshold time and fan is still on
  and17: hx.comps::And? <cdlInstance, cdlName:"and17", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"and10.out">
    inB: <link:"truDel8.out">
  }
  // Logical and
  and18: hx.comps::And? <cdlInstance, cdlName:"and18", cdlOf:@kw.cdl::cdl-LogicalAnd, cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inA: <link:"and9.out">
    inB: <link:"isOcc.out">
  }
  // Logical and
  and19: hx.comps::And? <cdlInstance, cdlName:"and19", cdlOf:@kw.cdl::cdl-LogicalAnd, cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inA: <link:"and7.out">
    inB: <link:"isOcc.out">
  }
  // Measured airflow has been less than threshold value for sufficient time
  and2: hx.comps::And? <cdlInstance, cdlName:"and2", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"truDel.out">
    inB: <link:"truDel9.out">
  }
  // Logical and
  and3: hx.comps::And? <cdlInstance, cdlName:"and3", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"and14.out">
    inB: <link:"isOcc.out">
  }
  // Logical and
  and4: hx.comps::And? <cdlInstance, cdlName:"and4", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"and2.out">
    inB: <link:"greThr1.out">
  }
  // Check if the measured airflow is greater than the threshold and the AHU supply fan is OFF
  and5: hx.comps::And? <cdlInstance, cdlName:"and5", cdlOf:@kw.cdl::cdl-LogicalAnd> {
    inA: <link:"gre1.out">
    inB: <link:"not3.out">
  }
  // Discharge temperature has been less than threshold and the hot water plant is proven on
  and6: hx.comps::And? <cdlInstance, cdlName:"and6", cdlOf:@kw.cdl::cdl-LogicalAnd, cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inA: <link:"les1.out">
    inB: <link:"u1HotPla">
  }
  // Logical and
  and7: hx.comps::And? <cdlInstance, cdlName:"and7", cdlOf:@kw.cdl::cdl-LogicalAnd, cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inA: <link:"truDel4.out">
    inB: <link:"greThr2.out">
  }
  // Discharge temperature has been less than threshold and the hot water plant is proven on
  and8: hx.comps::And? <cdlInstance, cdlName:"and8", cdlOf:@kw.cdl::cdl-LogicalAnd, cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inA: <link:"les2.out">
    inB: <link:"u1HotPla">
  }
  // Logical and
  and9: hx.comps::And? <cdlInstance, cdlName:"and9", cdlOf:@kw.cdl::cdl-LogicalAnd, cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inA: <link:"truDel5.out">
    inB: <link:"greThr2.out">
  }
  // Level 2 low airflow alarm
  assMes: hx.comps::Assert? <cdlInstance, cdlName:"assMes", cdlOf:@kw.cdl::cdl-UtilitiesAssert, cdlFinalBind:"message"> {
    message: "Warning: airflow is less than 50% of the setpoint."
    in: <link:"not1.out">
  }
  // Level 3 low airflow alarm
  assMes1: hx.comps::Assert? <cdlInstance, cdlName:"assMes1", cdlOf:@kw.cdl::cdl-UtilitiesAssert, cdlFinalBind:"message"> {
    message: "Warning: airflow is less than 70% of the setpoint."
    in: <link:"not2.out">
  }
  // Level 3 airflow sensor alarm
  assMes2: hx.comps::Assert? <cdlInstance, cdlName:"assMes2", cdlOf:@kw.cdl::cdl-UtilitiesAssert, cdlFinalBind:"message"> {
    message: "Warning: airflow sensor should be calibrated."
    in: <link:"not4.out">
  }
  // Level 4 leaking damper alarm
  assMes3: hx.comps::Assert? <cdlInstance, cdlName:"assMes3", cdlOf:@kw.cdl::cdl-UtilitiesAssert, cdlFinalBind:"message"> {
    message: "Warning: the damper is leaking."
    in: <link:"not5.out">
  }
  // Level 2 low discharge air temperature alarm
  assMes4: hx.comps::Assert? <cdlInstance, cdlName:"assMes4", cdlOf:@kw.cdl::cdl-UtilitiesAssert, cdlFinalBind:"message", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    message: "Warning: discharge air temperature is 17 degC less than the setpoint."
    in: <link:"not6.out">
  }
  // Level 3 low airflow alarm
  assMes5: hx.comps::Assert? <cdlInstance, cdlName:"assMes5", cdlOf:@kw.cdl::cdl-UtilitiesAssert, cdlFinalBind:"message", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    message: "Warning: discharge air temperature is 8 degC less than the setpoint."
    in: <link:"not7.out">
  }
  // Level 4 leaking valve alarm
  assMes6: hx.comps::Assert? <cdlInstance, cdlName:"assMes6", cdlOf:@kw.cdl::cdl-UtilitiesAssert, cdlFinalBind:"message"> {
    message: "Warning: the valve is leaking."
    in: <link:"not8.out">
  }
  // Level 2 fan status alarm
  assMes7: hx.comps::Assert? <cdlInstance, cdlName:"assMes7", cdlOf:@kw.cdl::cdl-UtilitiesAssert, cdlFinalBind:"message"> {
    message: "Warning: fan has been commanded ON but still OFF."
    in: <link:"not10.out">
  }
  // Level 4 fan status alarm
  assMes8: hx.comps::Assert? <cdlInstance, cdlName:"assMes8", cdlOf:@kw.cdl::cdl-UtilitiesAssert, cdlFinalBind:"message"> {
    message: "Warning: fan has been commanded OFF but still ON."
    in: <link:"not11.out">
  }
  // Convert boolean true to level 3 alarm
  booToInt: hx.comps::NumberSwitch? <cdlInstance, cdlName:"booToInt", cdlOf:@kw.cdl::cdl-ConversionsBooleanToInteger, cdlDefaulted:"integerFalse", cdlFinalBind:"integerTrue"> {
    inFalse: <link:"booToInt_integerFalse.out">
    inTrue: <link:"booToInt_integerTrue.out">
    inSwitch: <link:"and3.out">
  }
  // Suppress the alarm when multiplier is zero
  booToInt1: hx.comps::NumberSwitch? <cdlInstance, cdlName:"booToInt1", cdlOf:@kw.cdl::cdl-ConversionsBooleanToInteger, cdlDefaulted:"integerFalse,integerTrue"> {
    inFalse: <link:"booToInt1_integerFalse.out">
    inTrue: <link:"booToInt1_integerTrue.out">
    inSwitch: <link:"greThr1.out">
  }
  // Convert boolean true to level 3 alarm
  booToInt2: hx.comps::NumberSwitch? <cdlInstance, cdlName:"booToInt2", cdlOf:@kw.cdl::cdl-ConversionsBooleanToInteger, cdlDefaulted:"integerFalse", cdlFinalBind:"integerTrue"> {
    inFalse: <link:"booToInt2_integerFalse.out">
    inTrue: <link:"booToInt2_integerTrue.out">
    inSwitch: <link:"truDel2.out">
  }
  // Convert boolean true to level 4 alarm
  booToInt3: hx.comps::NumberSwitch? <cdlInstance, cdlName:"booToInt3", cdlOf:@kw.cdl::cdl-ConversionsBooleanToInteger, cdlDefaulted:"integerFalse", cdlFinalBind:"integerTrue"> {
    inFalse: <link:"booToInt3_integerFalse.out">
    inTrue: <link:"booToInt3_integerTrue.out">
    inSwitch: <link:"truDel3.out">
  }
  // Convert boolean true to level 3 alarm
  booToInt4: hx.comps::NumberSwitch? <cdlInstance, cdlName:"booToInt4", cdlOf:@kw.cdl::cdl-ConversionsBooleanToInteger, cdlDefaulted:"integerFalse", cdlFinalBind:"integerTrue", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inFalse: <link:"booToInt4_integerFalse.out">
    inTrue: <link:"booToInt4_integerTrue.out">
    inSwitch: <link:"and18.out">
  }
  // Suppress the alarm when multiplier is zero
  booToInt5: hx.comps::NumberSwitch? <cdlInstance, cdlName:"booToInt5", cdlOf:@kw.cdl::cdl-ConversionsBooleanToInteger, cdlDefaulted:"integerFalse,integerTrue", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inFalse: <link:"booToInt5_integerFalse.out">
    inTrue: <link:"booToInt5_integerTrue.out">
    inSwitch: <link:"greThr2.out">
  }
  // Convert boolean true to level 4 alarm
  booToInt6: hx.comps::NumberSwitch? <cdlInstance, cdlName:"booToInt6", cdlOf:@kw.cdl::cdl-ConversionsBooleanToInteger, cdlDefaulted:"integerFalse", cdlFinalBind:"integerTrue"> {
    inFalse: <link:"booToInt6_integerFalse.out">
    inTrue: <link:"booToInt6_integerTrue.out">
    inSwitch: <link:"truDel6.out">
  }
  // Convert boolean true to level 3 alarm
  booToInt7: hx.comps::NumberSwitch? <cdlInstance, cdlName:"booToInt7", cdlOf:@kw.cdl::cdl-ConversionsBooleanToInteger, cdlDefaulted:"integerFalse", cdlFinalBind:"integerTrue"> {
    inFalse: <link:"booToInt7_integerFalse.out">
    inTrue: <link:"booToInt7_integerTrue.out">
    inSwitch: <link:"and17.out">
  }
  // Check if damper position is near zero
  cloDam: hx.comps::LessThanHys? <cdlInstance, cdlName:"cloDam", cdlOf:@kw.cdl::cdl-RealsLessThreshold, cdlBind:{h:"0.5*damPosHys", t:"damPosHys"}, cdlFinalBind:"h,t"> {
    inB: <link:"cloDam_t.out">
