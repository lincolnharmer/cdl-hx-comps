  damVal: kw.cdl.g36.terminal::TerminalUnitsReheatSubsequencesDamperValves? <cdlInstance, cdlName:"damVal", cdlBind:{tDisMin:"TDisMin", tdDam:"TdDam", tdVal:"TdVal", tiDam:"TiDam", tiVal:"TiVal", vCooMax_flow:"VCooMax_flow", vHeaMax_flow:"VHeaMax_flow", vMin_flow:"VMin_flow", controllerTypeDam:"controllerTypeDam", controllerTypeVal:"controllerTypeVal", dTDisZonSetMax:"dTDisZonSetMax", dTHys:"dTHys", kDam:"kDam", kVal:"kVal", looHys:"looHys"}, cdlFinalBind:"controllerTypeDam,controllerTypeVal,dTDisZonSetMax,dTHys,kDam,kVal,looHys,tDisMin,tdDam,tdVal,tiDam,tiVal,vCooMax_flow,vHeaMax_flow,vMin_flow"> {
    tDis: <link:"tDis">
