@cdl-UtilitiesAssert: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Utilities.Assert"
  grade: "nativeParams"
  clause: "7.5.100.1"
  comp: hx.comps::Assert
  connectors: {u:"in"}
  params: {message:"message"}
  departures: {"When `in` turns false the comp logs a warning to the `hxComps` log, at most hourly. It never throws or faults.", "An invalid `in` is not checked.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"F", note:"Booleans; a time parameter declares its unit"}
  state: "stateless"
}

// The CDL elementary classes no hx.comps comp or composition runs, and no G36 sequence uses.
@cdl-refused: CdlRefused {
  classes: {
    CdlRefusal {name:"RealsSourcesCalendarTime", cdlClass:"Buildings.Controls.OBC.CDL.Reals.Sources.CalendarTime", clause:"7.5.80.1", reason:"No comp outputs year, month, day, hour, minute and weekday as numbers", state:"stateful", stateInit:"noInput", stateInitBasis:"noInputConnector", stateBasis:"discrete; unread: instance calTim is of Buildings.Utilities.Time.CalendarTime, which the pinned source does not hold"}
    CdlRefusal {name:"RealsSourcesCivilTime", cdlClass:"Buildings.Controls.OBC.CDL.Reals.Sources.CivilTime", clause:"7.5.81.1", reason:"No comp outputs time as seconds", state:"stateless"}
    CdlRefusal {name:"RealsSourcesRamp", cdlClass:"Buildings.Controls.OBC.CDL.Reals.Sources.Ramp", clause:"7.5.84.1", reason:"CDL Ramp is one-shot: `offset` before `startTime`, then a rise of `height` over `duration`", state:"stateless"}
    CdlRefusal {name:"RealsSourcesSin", cdlClass:"Buildings.Controls.OBC.CDL.Reals.Sources.Sin", clause:"7.5.86.1", reason:"SineWave has no `phase` or `startTime`, measures `amplitude` peak to peak, takes a `period` of at least 1sec, and is phased from its own start", state:"stateless"}
    CdlRefusal {name:"UtilitiesSunRiseSet", cdlClass:"Buildings.Controls.OBC.CDL.Utilities.SunRiseSet", clause:"7.5.101.1", reason:"No comp computes sunrise or sunset times", state:"stateful", stateInit:"noInput", stateInitBasis:"noInputConnector", stateBasis:"pre; when; initialParameter"}
  }
}
