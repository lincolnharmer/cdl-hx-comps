  state: "stateful"
  stateInit: "readsInput"
  stateBasis: "instance cycOut; instance edg2; instance greThr; instance preBre; instance triSam; instance truFalHol"
}

@cdl-LogicalXor: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Logical.Xor"
  grade: "native"
  clause: "7.5.53.1"
  comp: hx.comps::Xor
  connectors: {u1:"inA", u2:"inB", y:"out"}
  departures: {"Xor needs 2 non-null inputs (`minInputs := 2`), so one null input gives null `out`, where And and Or compute from the other input.", "QuadLogic computes from the valid inputs and skips a null or invalid one. Fewer non-null inputs than the comp needs give null `out`. Otherwise `out` merges the status of every input, so an invalid status propagates as the spec doc says.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"F", note:"Booleans; a time parameter declares its unit"}
  state: "stateless"
}

@cdl-PsychrometricsDewPoint_TDryBulPhi: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Psychrometrics.DewPoint_TDryBulPhi"
  grade: "native"
  clause: "7.5.54.1"
  comp: hx.comps::DewPoint
  connectors: {phi:"inRelHumidity", tDryBul:"inDryBulb", tDewPoi:"out"}
  departures: {"Below the triple point `out` is the frost point over ice, where MBL gives a dew point over liquid water.", "A dew point below 100 K gives NaN with fault.", "`out` is in the unit of `inDryBulb`.", "`inDryBulb` is in kelvin when unitless, and K, °C and °F convert. `inRelHumidity` is a fraction when unitless, and % converts.", "An out of range or non-finite input gives NaN with no fault.", "It computes with the 2025 ASHRAE Handbook and IAPWS-IF97, not the 2009 equations named in ASHRAE 231 7.5.54 and 7.5.55.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"A", keep:"TDryBul,TDewPoi"}
  cdlNames: {tDryBul:"TDryBul", tDewPoi:"TDewPoi"}
  bounds: {phi:{cdlMin:"0", cdlMax:"1"}, tDryBul:{cdlMin:"100"}, tDewPoi:{cdlMin:"100"}}
  state: "stateless"
}

@cdl-PsychrometricsSpecificEnthalpy_TDryBulPhi: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Psychrometrics.SpecificEnthalpy_TDryBulPhi"
  grade: "nativeParams"
  clause: "7.5.55.1"
  comp: hx.comps::SpecificEnthalpy
  connectors: {phi:"inRelHumidity", tDryBul:"inDryBulb", h:"out"}
  params: {pAtm:"pAtm"}
  departures: {"Below 0 °C p_ws is over liquid water, where MBL takes it over ice. `out` is 247 J/kg higher at -5 °C and 80 %.", "`out` carries `J/kg` only when `inDryBulb` has a unit.", "`inDryBulb` is in kelvin when unitless, and K, °C and °F convert. `inRelHumidity` is a fraction when unitless, and % converts.", "An out of range or non-finite input gives NaN with no fault.", "It computes with the 2025 ASHRAE Handbook and IAPWS-IF97, not the 2009 equations named in ASHRAE 231 7.5.54 and 7.5.55.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"D", note:"every connector and pAtm declare their unit"}
  cdlNames: {tDryBul:"TDryBul"}
  bounds: {phi:{cdlMin:"0", cdlMax:"1"}, tDryBul:{cdlMin:"100"}}
  state: "stateless"
}

@cdl-PsychrometricsWetBulb_TDryBulPhi: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Psychrometrics.WetBulb_TDryBulPhi"
  grade: "native"
