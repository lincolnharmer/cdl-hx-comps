  // Zone cooling air distribution effectiveness
  zonDisEff_cool: Number? <cdlParam, cdlName:"zonDisEff_cool", cdlType:"Real", cdlUnit:"1", unitless, cdlEnable:"venStd == Buildings.Controls.OBC.ASHRAE.G36.Types.VentilationStandard.ASHRAE62_1", cdlGroup:"Distribution effectiveness", cdlTab:"Advanced", cdlValueInReference:"true"> "1"
  // Zone heating air distribution effectiveness
