@cdl-RealsMax: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Reals.Max"
  grade: "native"
  clause: "7.5.21.1"
  comp: hx.comps::Maximum
  connectors: {u1:"inA", u2:"inB", y:"out"}
  departures: {"QuadMath computes from the valid inputs and skips a null or invalid one. Fewer valid inputs than the comp needs give null `out`. Otherwise `out` merges the status of every input, valid or not, so an invalid status propagates as the spec doc says. A unit error adds fault.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"A", keep:"u1,u2,y"}
