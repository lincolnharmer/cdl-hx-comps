  booToInt: hx.comps::NumberSwitch? <cdlInstance, cdlName:"booToInt", cdlOf:@kw.cdl::cdl-ConversionsBooleanToInteger, cdlDefaulted:"integerFalse", cdlFinalBind:"integerTrue"> {
    inFalse: <link:"booToInt_integerFalse.out">
    inTrue: <link:"booToInt_integerTrue.out">
