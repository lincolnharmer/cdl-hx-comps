@cdl-RealsLimitSlewRate: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Reals.LimitSlewRate"
  grade: "nativeParams"
  clause: "7.5.14.1"
  comp: hx.comps::SlewRateLimit
  connectors: {u:"in", y:"out"}
  params: {enable:"enable", fallingSlewRate:"fallingSlewRate", raisingSlewRate:"raisingSlewRate", td:"timeConst"}
  convert: {td:"sec"}
  departures: {"A null `fallingSlewRate` is minus `raisingSlewRate` and a null `timeConst` is `raisingSlewRate` times 10 s, the CDL defaults.", "Rates are in units of `in` per second unless they carry a time unit, matching CDL `1/s` on a unitless `u`.", "Each step is backward Euler to the current `in`, so `out` has direct feedthrough.", "The comp executes every cycle and steps on its own CycleClock. A step longer than both 1min and 10 times the longest of the last 8 steps is a stall or a gap. Results depend on the cycle length.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"A", keep:"u,y", note:"a slew rate is the unit of u per second, a compound with no symbol"}
  cdlNames: {td:"Td"}
  bounds: {fallingSlewRate:{maxVal:"-1e-37", cdlMaxConst:"-Constants.small"}, raisingSlewRate:{minVal:"1e-37", cdlMinConst:"Constants.small"}, td:{minVal:"1e-15", cdlMinConst:"Constants.eps"}}
  state: "stateful"
  stateInit: "readsInput"
  stateBasis: "der"
}

