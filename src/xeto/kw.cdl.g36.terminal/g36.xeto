    inB: <link:"gai.out">
  }
  // Discharge temperature lower than setpoint by a threshold
  les1: hx.comps::LessThanHys? <cdlInstance, cdlName:"les1", cdlOf:@kw.cdl::cdl-RealsLess, cdlBind:{h:"dTHys"}, cdlFinalBind:"h", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inA: <link:"tDis">
    inB: <link:"addPar.out">
  }
  // Discharge temperature lower than setpoint by a threshold
  les2: hx.comps::LessThanHys? <cdlInstance, cdlName:"les2", cdlOf:@kw.cdl::cdl-RealsLess, cdlBind:{h:"dTHys"}, cdlFinalBind:"h", cdlCondition:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased"> {
    inA: <link:"tDis">
    inB: <link:"addPar1.out">
  }
