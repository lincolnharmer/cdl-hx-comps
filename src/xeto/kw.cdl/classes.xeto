@cdl-RealsDerivative: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Reals.Derivative"
  grade: "nativeParams"
  clause: "7.5.10.1"
  comp: hx.comps::Derivative
  connectors: {u:"in", y:"out"}
  params: {y_start:"yStart"}
  feeds: {k:{slot:"k", via:hx.comps::StatusNumberToNumber}, t:{slot:"timeConst", via:hx.comps::StatusNumberToNumber}}
  whenNull: {k:1, t:1}
  departures: {"CDL `k` and `T` are input connectors. On the comp they are plain Number slots.", "`timeConst` is in seconds unless it carries a time unit. A `timeConst` below 0 faults. CDL requires `T` at least 1E-13.", "`out` has no unit.", "The comp executes every cycle and steps on its own CycleClock. A step longer than both 1min and 10 times the longest of the last 8 steps is a stall or a gap. Results depend on the cycle length.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"D", note:"y is k times the derivative of u, a compound unit"}
  cdlNames: {t:"T"}
  bounds: {t:{cdlMin:"1e-13", cdlMinConst:"100*Buildings.Controls.OBC.CDL.Constants.eps"}}
  state: "stateful"
  stateInit: "readsInput"
  stateBasis: "der"
}

