  connectors: {f1:"inF1", f2:"inF2", u:"in", x1:"inX1", x2:"inX2", y:"out"}
  params: {limitAbove:"limitAbove", limitBelow:"limitBelow"}
  departures: {"An `inX2` not above `inX1` while a limit is on gives NaN with fault, where MBL warns.", "Each axis converts to the unit of its first input with a unit.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"A", keep:"f1,f2,y;u,x1,x2"}
  state: "stateless"
}

