}

@cdl-RealsModulo: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Reals.Modulo"
  grade: "native"
  clause: "7.5.23.1"
  comp: hx.comps::FlooredModulus
  connectors: {u1:"inA", u2:"inB", y:"out"}
  departures: {"A zero `inB` or an infinite input gives NaN.", "BinaryMath: a null input gives null `out`. An invalid input gives NaN with the merged status. A unit error gives NaN with fault.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"A", keep:"u1,u2,y"}
  state: "stateless"
}

@cdl-RealsMovingAverage: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Reals.MovingAverage"
  grade: "nativeParams"
  clause: "7.5.24.1"
  comp: hx.comps::MovingAverage
  connectors: {u:"in", y:"out"}
  params: {delta:"window"}
  convert: {delta:"sec"}
  departures: {"Before a full window the elapsed time is guarded by 1E-10 s, as ASHRAE 231 7.5.24. MBL adds 1E-3 s, so the first seconds differ slightly.", "The comp keeps one entry per execute in the window. A long window at a short cycle holds many entries.", "CDL `delta` has no default. `window` defaults to 1min.", "The comp executes every cycle and steps on its own CycleClock. A step longer than both 1min and 10 times the longest of the last 8 steps is a stall or a gap. Results depend on the cycle length.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"A", keep:"u,y"}
  bounds: {delta:{minVal:"1e-05"}}
  state: "stateful"
  stateInit: "noInput"
  stateInitBasis: "parameterInit"
  stateBasis: "when; der; delay; initialParameter"
}

