@cdl-RealsMultiply: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Reals.Multiply"
  grade: "native"
  clause: "7.5.27.1"
  comp: hx.comps::Multiply
  connectors: {u1:"inA", u2:"inB", y:"out"}
  departures: {"QuadMath computes from the valid inputs and skips a null or invalid one. Fewer valid inputs than the comp needs give null `out`. Otherwise `out` merges the status of every input, valid or not, so an invalid status propagates as the spec doc says. A unit error adds fault.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"C", op:"mul", ins:"u1,u2", out:"y"}
  state: "stateless"
}

@cdl-RealsMultiplyByParameter: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Reals.MultiplyByParameter"
  grade: "nativeParams"
  clause: "7.5.28.1"
  comp: hx.comps::Multiply
  connectors: {u:"inA", y:"out"}
  feeds: {k:{slot:"inB", via:hx.comps::NumberConst}}
  compoundGain: {comp:"hx.comps::Line", gain:"inF2", per:"inX2", perGroup:"u", zero:"inX1,inF1", fixed:{limitBelow:"false", limitAbove:"false"}}
  departures: {"A gain bound to a unit the unit database lacks (s/K, the change rate chaRat of Generic.TimeSuppression) runs on `Line` instead, through (0, 0) and (1 K, chaRat s). Multiply would give the product the unit of `u`, K, and a K value then meets seconds in a comparison and faults. Line gives `out` the unit of its second axis, seconds. Its first axis takes the unit of `u`, and Line does not convert a difference against an absolute value, so the resolver converts the point 1 K with the unit group of `u`, as a difference (1.8 Fahrenheit degrees on a Fahrenheit building), and writes chaRat in seconds unconverted. 540 s per kelvin then acts as 300 s per Fahrenheit degree.", "QuadMath computes from the valid inputs and skips a null or invalid one. Fewer valid inputs than the comp needs give null `out`. Otherwise `out` merges the status of every input, valid or not, so an invalid status propagates as the spec doc says. A unit error adds fault.", "The target slot is transient, so a fixed value must arrive on a linked NumberConst. A value set on a transient slot is not saved.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"C", op:"mul", ins:"u,k", out:"y"}
  state: "stateless"
}

@cdl-RealsPid: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Reals.PID"
  grade: "nativeParams"
  clause: "7.5.30.1"
  comp: hx.comps::CdlPid
  connectors: {u_m:"inMeasurement", u_s:"inSetpoint", y:"out"}
  params: {controllerType:"controllerType", k:"k", nd:"nd", ni:"ni", r:"r", reverseActing:"reverseActing", td:"td", ti:"ti", xi_start:"xiStart", yd_start:"ydStart", yMax:"yMax", yMin:"yMin"}
  convert: {controllerType:"enum P=p PI=pi PD=pd PID=pid", k:"float", nd:"float", ni:"float", r:"float", td:"sec", ti:"sec", xi_start:"float", yd_start:"float", yMax:"float", yMin:"float"}
  writeWhenUnit: "r"
  departures: {"`k`, `r`, `yMax`, `yMin`, `xi_start`, `yd_start` and `y_reset` are Float slots, which carry no unit. `r` scales the control error, so on points that are not SI it must be converted into their difference unit (5 K is 9 Fahrenheit degrees), and the comp cannot catch a conversion that was missed. `r` is written on every loop whose setpoint carries a unit. Any `1/K` is provenance only and is never converted (in G36 every one is the `k` of a PID): converting `r` alone converts the loop.", "Equal `yMin` and `yMax` give that value. MBL rejects them.", "Parameters are checked only for the terms the controller type uses.", "The comp executes every cycle with backward Euler steps and an implicit anti-windup, so its response depends on the cycle length.", "An invalid input holds the state and `out` and propagates the status. A non-finite input faults.", "The comp executes every cycle and steps on its own CycleClock. A step longer than both 1min and 10 times the longest of the last 8 steps is a stall or a gap. Results depend on the cycle length.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"B", keep:"u_s,u_m", op:"delta", ins:"u_s", out:"r", seeds:{xi_start:"1", y:"1", yMax:"1", yMin:"1", yd_start:"1"}, note:"r scales the control error, so it is a difference in the unit of u_s"}
  cdlNames: {nd:"Nd", ni:"Ni", td:"Td", ti:"Ti"}
  bounds: {k:{minVal:"1e-13", cdlMinConst:"100*Constants.eps"}, nd:{minVal:"1e-13", cdlMinConst:"100*Constants.eps"}, ni:{minVal:"1e-13", cdlMinConst:"100*Constants.eps"}, r:{minVal:"1e-13", cdlMinConst:"100*Constants.eps"}, td:{minVal:"1e-13", cdlMinConst:"100*Constants.eps"}, ti:{minVal:"1e-13", cdlMinConst:"100*Constants.eps"}}
  state: "stateful"
  stateInit: "readsInput"
  stateBasis: "instance D (conditional); instance I (conditional)"
}

@cdl-RealsPidWithReset: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Reals.PIDWithReset"
  grade: "nativeParams"
  clause: "7.5.31.1"
  comp: hx.comps::CdlPid
  connectors: {trigger:"inReset", u_m:"inMeasurement", u_s:"inSetpoint", y:"out"}
  params: {controllerType:"controllerType", k:"k", nd:"nd", ni:"ni", r:"r", reverseActing:"reverseActing", td:"td", ti:"ti", xi_start:"xiStart", y_reset:"yReset", yd_start:"ydStart", yMax:"yMax", yMin:"yMin"}
  convert: {controllerType:"enum P=p PI=pi PD=pd PID=pid", k:"float", nd:"float", ni:"float", r:"float", td:"sec", ti:"sec", xi_start:"float", y_reset:"float", yd_start:"float", yMax:"float", yMin:"float"}
  cdlDefaults: {y_reset:"xi_start"}
  writeWhenUnit: "r"
  departures: {"`k`, `r`, `yMax`, `yMin`, `xi_start`, `yd_start` and `y_reset` are Float slots, which carry no unit. `r` scales the control error, so on points that are not SI it must be converted into their difference unit (5 K is 9 Fahrenheit degrees), and the comp cannot catch a conversion that was missed. `r` is written on every loop whose setpoint carries a unit. Any `1/K` is provenance only and is never converted (in G36 every one is the `k` of a PID): converting `r` alone converts the loop.", "On a rise of `inReset`, PI and PID set the integrator so the output before the limits is `yReset`. With P or PD, `inReset` does nothing.", "Equal `yMin` and `yMax` give that value. MBL rejects them.", "Parameters are checked only for the terms the controller type uses.", "The comp executes every cycle with backward Euler steps and an implicit anti-windup, so its response depends on the cycle length.", "An invalid input holds the state and `out` and propagates the status. A non-finite input faults.", "The comp executes every cycle and steps on its own CycleClock. A step longer than both 1min and 10 times the longest of the last 8 steps is a stall or a gap. Results depend on the cycle length.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"B", keep:"u_s,u_m", op:"delta", ins:"u_s", out:"r", seeds:{xi_start:"1", y:"1", yMax:"1", yMin:"1", y_reset:"1", yd_start:"1"}, note:"r scales the control error, so it is a difference in the unit of u_s"}
  cdlNames: {nd:"Nd", ni:"Ni", td:"Td", ti:"Ti"}
  bounds: {k:{minVal:"1e-13", cdlMinConst:"100*Constants.eps"}, nd:{minVal:"1e-13", cdlMinConst:"100*Constants.eps"}, ni:{minVal:"1e-13", cdlMinConst:"100*Constants.eps"}, r:{minVal:"1e-13", cdlMinConst:"100*Constants.eps"}, td:{minVal:"1e-13", cdlMinConst:"100*Constants.eps"}, ti:{minVal:"1e-13", cdlMinConst:"100*Constants.eps"}}
  state: "stateful"
  stateInit: "readsInput"
  stateBasis: "instance D (conditional); instance I (conditional)"
}

@cdl-RealsRamp: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Reals.Ramp"
  grade: "nativeParams"
  clause: "7.5.70.1"
  comp: hx.comps::SlewRateLimit
  connectors: {u:"in", y:"out"}
  params: {fallingSlewRate:"fallingSlewRate", raisingSlewRate:"raisingSlewRate", td:"timeConst"}
  feeds: {active:{slot:"enable", via:hx.comps::StatusBoolToBool}}
  convert: {td:"sec"}
  cdlDefaults: {td:"raisingSlewRate*0.001"}
  departures: {"CDL `active` is an input. The comp `enable` is a plain Bool slot, reached through a StatusBoolToBool feed. A null `active` then reads `whenNull`, false by default, so `out` follows `in`.", "MBL Ramp reinitializes the ramp to `u` on a rise of `active` and outputs `u` while inactive. The comp gives `out = in` while disabled, so it starts from `in` on enable too.", "The comp executes every cycle and steps on its own CycleClock. A step longer than both 1min and 10 times the longest of the last 8 steps is a stall or a gap. Results depend on the cycle length.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"A", keep:"u,y", note:"a slew rate is the unit of u per second, a compound with no symbol"}
  cdlNames: {td:"Td"}
  bounds: {fallingSlewRate:{maxVal:"-1e-37", cdlMaxConst:"-Constants.small"}, raisingSlewRate:{minVal:"1e-37", cdlMinConst:"Constants.small"}, td:{minVal:"1e-15", cdlMinConst:"Constants.eps"}}
  state: "stateful"
  stateInit: "readsInput"
  stateBasis: "when; der; reinit"
}

