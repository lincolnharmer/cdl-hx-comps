  kHeaCon: Number? <cdlParam, cdlName:"kHeaCon", cdlType:"Real", minVal:"1e-13", cdlMinVia:"conLoo.conHea.k", cdlGroup:"Heating", cdlTab:"Control loops", cdlValueInReference:"false"> "0.1"
  // Gain of controller for valve control
  kVal: Number? <cdlParam, cdlName:"kVal", cdlType:"Real", cdlUnitInferred:"1/K", cdlUnitVia:"damVal.kVal", minVal:"1e-13", cdlMinVia:"damVal.conVal.k", cdlGroup:"Valve", cdlTab:"Damper and valve control", cdlValueInReference:"false"> "0.5"
  // Threshold time to check damper leaking airflow
  leaFloTim: Number? <cdlParam, cdlName:"leaFloTim", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", cdlTab:"Alarms", cdlValueInReference:"true"> "600"
  // Loop output hysteresis below which the output will be seen as zero
  looHys: Number? <cdlParam, cdlName:"looHys", cdlType:"Real", cdlUnit:"1", unitless, minVal:"0", cdlMinVia:"sysReq.greThr.h", cdlTab:"Advanced", cdlValueInReference:"false"> "0.01"
  // Threshold time to check low flow rate
  lowFloTim: Number? <cdlParam, cdlName:"lowFloTim", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", cdlTab:"Alarms", cdlValueInReference:"true"> "300"
  // Threshold time to check low discharge temperature
  lowTemTim: Number? <cdlParam, cdlName:"lowTemTim", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", cdlEnable:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased", cdlTab:"Alarms", cdlValueInReference:"true"> "600"
  // Maximum suppression time
  maxSupTim: Number? <cdlParam, cdlName:"maxSupTim", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", cdlTab:"Time-based suppresion", cdlValueInReference:"true"> "1800"
  // True: occupied-standby mode is permitted
  permit_occStandby: Bool? <cdlParam, cdlName:"permit_occStandby", cdlType:"Boolean", cdlEnable:"venStd == Buildings.Controls.OBC.ASHRAE.G36.Types.VentilationStandard.ASHRAE62_1 and have_occSen", cdlValueInReference:"false"> "true"
  // Sample period of component, set to the same value as the trim and respond that process static pressure reset
  samplePeriod: Number? <cdlParam, cdlName:"samplePeriod", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", minVal:"0.001", cdlMinVia:"sysReq.sampler.samplePeriod", cdlTab:"Time-based suppresion", cdlValueInReference:"false"> "120"
  // Importance multiplier for the zone static pressure reset control loop
  staPreMul: Number? <cdlParam, cdlName:"staPreMul", cdlType:"Real", cdlTab:"Alarms", cdlValueInReference:"false"> "1"
  // Delay triggering alarms after enabling AHU supply fan
  staTim: Number? <cdlParam, cdlName:"staTim", cdlType:"Real", cdlUnit:"s", cdlQuantityKind:"Time", quantity:"time", unit:"sec", cdlTab:"Advanced", cdlValueInReference:"false"> "1800"
  // Time constant of derivative block for damper control
  tdDam: Number? <cdlParam, cdlName:"TdDam", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", minVal:"1e-13", cdlMinVia:"damVal.conDam.td", cdlEnable:"(controllerTypeDam == Buildings.Controls.OBC.CDL.Types.SimpleController.PD or controllerTypeDam == Buildings.Controls.OBC.CDL.Types.SimpleController.PID)", cdlGroup:"Damper", cdlTab:"Damper and valve control", cdlValueInReference:"false"> "0.1"
  // Lowest discharge air temperature
  tDisMin: Number? <cdlParam, cdlName:"TDisMin", cdlType:"Real", cdlUnit:"K", quantity:"temperature", cdlQuantityInferred, cdlTab:"Damper and valve control", cdlValueInReference:"true"> "283.15"
  // Time constant of derivative block for valve control
  tdVal: Number? <cdlParam, cdlName:"TdVal", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", minVal:"1e-13", cdlMinVia:"damVal.conVal.td", cdlEnable:"controllerTypeVal == Buildings.Controls.OBC.CDL.Types.SimpleController.PD or controllerTypeVal == Buildings.Controls.OBC.CDL.Types.SimpleController.PID", cdlGroup:"Valve", cdlTab:"Damper and valve control", cdlValueInReference:"false"> "0.1"
  // Threshold difference between discharge air temperature and its setpoint for generating 3 hot water reset requests
  thrTDis_1: Number? <cdlParam, cdlName:"thrTDis_1", cdlType:"Real", cdlUnit:"K", cdlQuantityInferred, cdlDelta, cdlEnable:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased", cdlTab:"System requests", cdlValueInReference:"true"> "17"
  // Threshold difference between discharge air temperature and its setpoint for generating 2 hot water reset requests
  thrTDis_2: Number? <cdlParam, cdlName:"thrTDis_2", cdlType:"Real", cdlUnit:"K", cdlQuantityInferred, cdlDelta, cdlEnable:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased", cdlTab:"System requests", cdlValueInReference:"true"> "8"
  // Threshold difference between zone temperature and cooling setpoint for generating 3 cooling SAT reset requests
  thrTemDif: Number? <cdlParam, cdlName:"thrTemDif", cdlType:"Real", cdlUnit:"K", cdlQuantityInferred, cdlDelta, cdlTab:"System requests", cdlValueInReference:"true"> "3"
  // Time constant of integrator block for cooling control loop
  tiCooCon: Number? <cdlParam, cdlName:"TiCooCon", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", minVal:"1e-13", cdlMinVia:"conLoo.conCoo.ti", cdlGroup:"Cooling", cdlTab:"Control loops", cdlValueInReference:"false"> "120"
  // Time constant of integrator block for damper control
  tiDam: Number? <cdlParam, cdlName:"TiDam", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", minVal:"1e-13", cdlMinVia:"damVal.conDam.ti", cdlEnable:"(controllerTypeDam == Buildings.Controls.OBC.CDL.Types.SimpleController.PI or controllerTypeDam == Buildings.Controls.OBC.CDL.Types.SimpleController.PID)", cdlGroup:"Damper", cdlTab:"Damper and valve control", cdlValueInReference:"false"> "300"
  // Time constant of integrator block for heating control loop
  tiHeaCon: Number? <cdlParam, cdlName:"TiHeaCon", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", minVal:"1e-13", cdlMinVia:"conLoo.conHea.ti", cdlGroup:"Heating", cdlTab:"Control loops", cdlValueInReference:"false"> "120"
  // Threshold time to check the zone temperature status
  timChe: Number? <cdlParam, cdlName:"timChe", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", cdlGroup:"Control loops", cdlTab:"Advanced", cdlValueInReference:"true"> "30"
  // Time constant of integrator block for valve control
  tiVal: Number? <cdlParam, cdlName:"TiVal", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", minVal:"1e-13", cdlMinVia:"damVal.conVal.ti", cdlEnable:"controllerTypeVal == Buildings.Controls.OBC.CDL.Types.SimpleController.PI or controllerTypeVal == Buildings.Controls.OBC.CDL.Types.SimpleController.PID", cdlGroup:"Valve", cdlTab:"Damper and valve control", cdlValueInReference:"false"> "300"
  // Threshold difference between zone temperature and cooling setpoint for generating 2 cooling SAT reset requests
  twoTemDif: Number? <cdlParam, cdlName:"twoTemDif", cdlType:"Real", cdlUnit:"K", cdlQuantityInferred, cdlDelta, cdlTab:"System requests", cdlValueInReference:"true"> "2"
  // Threshold time to check valve leaking water flow
  valCloTim: Number? <cdlParam, cdlName:"valCloTim", cdlType:"Real", cdlUnit:"s", quantity:"time", unit:"sec", cdlTab:"Alarms", cdlValueInReference:"true"> "900"
  // Near zero valve position, below which the valve will be seen as closed
  valPosHys: Number? <cdlParam, cdlName:"valPosHys", cdlType:"Real", cdlUnit:"1", unitless, cdlMinWhen:List {CdlBoundWhen {val:Number "0", cond:"heaCoi == Buildings.Controls.OBC.ASHRAE.G36.Types.HeatingCoil.WaterBased", via:"sysReq.greThr5.h"}}, cdlTab:"Advanced", cdlValueInReference:"false"> "0.005"
  // Design area component of the breathing zone outdoor airflow
  vAreBreZon_flow: Number <cdlParam, cdlName:"VAreBreZon_flow", cdlType:"Real", cdlUnit:"m³/s", quantity:"volumetricFlow", cdlEnable:"venStd == Buildings.Controls.OBC.ASHRAE.G36.Types.VentilationStandard.ASHRAE62_1", cdlGroup:"Design conditions">
  // Zone minimum outdoor airflow for building area
  vAreMin_flow: Number <cdlParam, cdlName:"VAreMin_flow", cdlType:"Real", cdlUnit:"m³/s", quantity:"volumetricFlow", cdlEnable:"venStd == Buildings.Controls.OBC.ASHRAE.G36.Types.VentilationStandard.California_Title_24">
  // Design zone cooling maximum airflow rate
  vCooMax_flow: Number <cdlParam, cdlName:"VCooMax_flow", cdlType:"Real", cdlUnit:"m³/s", quantity:"volumetricFlow", cdlGroup:"Design conditions">
