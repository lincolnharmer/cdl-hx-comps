@cdl-RealsIntegratorWithReset: CdlClass {
  cdlClass: "Buildings.Controls.OBC.CDL.Reals.IntegratorWithReset"
  grade: "nativeParams"
  clause: "7.5.13.1"
  comp: hx.comps::Integrator
  connectors: {trigger:"inReset", u:"in", y_reset_in:"inResetVal", y:"out"}
  params: {k:"k", y_start:"yStart"}
  departures: {"Each step is a trapezoid to the current `in`, so `out` has direct feedthrough from `in` where CDL has none. A loop through it needs a `loopCut` link.", "A reset while `inResetVal` is invalid or not finite waits until it is usable. A null `inResetVal` resets to `yStart`.", "`out` has no unit.", "After a restart `out` starts again from `yStart`.", "The comp executes every cycle and steps on its own CycleClock. A step longer than both 1min and 10 times the longest of the last 8 steps is a stall or a gap. Results depend on the cycle length.", "CDL values are never null and carry no status. Every hx.comps comp has its own null and status rule, given among its departures. A G36 sequence sees the difference only when an input point is null, stale or faulted."}
  unitRule: {family:"A", keep:"y,y_reset_in,y_start", note:"y is k times the integral of u, a compound unit"}
  state: "stateful"
  stateInit: "noInput"
  stateInitBasis: "parameterInit"
  stateBasis: "when; der; reinit"
}

