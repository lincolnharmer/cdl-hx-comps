  // CO2 concentration setpoint
  ppmCO2Set: hx.comps::StatusNumber? <cdlInput, cdlName:"ppmCO2Set", cdlType:"Real", cdlUnitInferred:"1", cdlPointUnit:"ppm", unitless, cdlCondition:"have_CO2Sen", cdlPointSpec:ph.points::ZoneCo2Sp, cdlPointScope:"zone">
